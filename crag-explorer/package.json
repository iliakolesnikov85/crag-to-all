{
  "name": "crag-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:use-emulator": "cross-env VITE_USE_FIREBASE_EMULATOR=true vite",
    "build": "node scripts/build.js",
    "build:use-emulator": "cross-env VITE_USE_FIREBASE_EMULATOR=true node scripts/build.js",
    "test": "vitest run",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "preview:use-emulator": "cross-env VITE_USE_FIREBASE_EMULATOR=true vite preview",
    "seo-check": "npm run build && node scripts/seo-check.js",
    "sitemap": "node scripts/sitemap-generator.js"
  },
  "dependencies": {
    "@crag-to-all/shared-crag": "file:../packages/shared-crag",
    "fast-json-stable-stringify": "^2.1.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "rc-slider": "^11.1.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router": "^8.2.0",
    "recharts": "^3.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.23",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "express": "^5.1.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "sass": "^1.89.2",
    "sharp": "^0.34.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
