{
  "name": "crag-api",
  "version": "0.1.0",
  "private": true,
  "description": "Local Express API for crag/sector documents in MongoDB",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@crag-to-all/shared-crag": "file:../packages/shared-crag",
    "@crag-to-all/shared-firebase": "file:../packages/shared-firebase",
    "cors": "^2.8.5",
    "dotenv": "^17.1.0",
    "express": "^5.1.0",
    "mongodb": "^7.6.0",
    "multer": "^2.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.0.10",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true
  }
}
